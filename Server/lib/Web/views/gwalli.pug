extends layout

block Subject
	title *** KKuTu Online 관리자 대시보드 ***

block JS
	script(type="text/javascript", src="/js/in_admin.min.js")
	script(type="text/javascript").
		$(document).ready(function() {
			// 탭 전환 처리 (인라인 스타일 충돌 방지를 위해 클래스 토글 방식 사용)
			$('.sidebar-menu li').on('click', function() {
				var tabId = $(this).data('tab');
				
				$('.sidebar-menu li').removeClass('active');
				$(this).addClass('active');
				
				$('.tab-content').removeClass('active');
				$('#' + tabId).addClass('active');
			});
		});

block Middle
	div.admin-container
		//- 상단 스티키 설정 영역 (Credentials & Language)
		header.admin-header
			div.header-brand
				i.fa.fa-sliders
				span KKuTu Online
				span.badge.badge-admin Admin Panel
			div.header-credentials
				input#db-password(type='hidden', value='')
				div.input-group-inline
					label: i.fa.fa-globe
					input#db-lang(placeholder='대상 테이블 (ko/en)', value='ko')

		div.admin-workspace
			//- 좌측 네비게이션 드로어
			aside.admin-sidebar
				div.sidebar-title
					i.fa.fa-bars
					span 메뉴 목록
				ul.sidebar-menu
					li.active(data-tab='tab-injeong')
						i.fa.fa-check-square-o
						span 어인정 신청 관리
					li(data-tab='tab-shop')
						i.fa.fa-shopping-bag
						span 상점 아이템 DB
					li(data-tab='tab-users')
						i.fa.fa-user-circle
						span 유저 데이터 DB
					li(data-tab='tab-gamsi')
						i.fa.fa-binoculars
						span 실시간 유저 감시
					li(data-tab='tab-kkutu')
						i.fa.fa-font
						span 끄투 단어 DB 수정
					li(data-tab='tab-add-words')
						i.fa.fa-plus-circle
						span 단어 대량 추가
					li(data-tab='tab-stats')
						i.fa.fa-line-chart
						span 인기 단어 통계

			//- 우측 대시보드 콘텐츠 영역
			main.admin-content-area
				//- 1. 어인정 신청 관리
				div#tab-injeong.tab-content.active
					div.content-card
						div.card-header
							h2: span 어인정 신청 관리
							p 유저들이 새롭게 제안한 어인정 단어들의 유효성을 확인하고 일괄 심사합니다.
						div.card-actions
							button#injeong-go.btn.btn-cyan: i.fa.fa-search  대기 목록 조회
							div.actions-divider
							button#injeong-everything.btn.btn-outline-green: i.fa.fa-check-double  모두 승인 선택
							button#injeong-nothing.btn.btn-outline-red: i.fa.fa-times  모두 승인 해제
							button#injeong-apply.btn.btn-solid-green: i.fa.fa-save  선택한 단어 심사 적용
						div.table-wrapper
							table.admin-table
								thead
									tr
										th(style="width: 70px; text-align: center;") 승인여부
										th(style="width: 90px; text-align: center;") 나무위키
										th(style="width: 150px;") 단어명
										th(style="width: 120px;") 주제 (Theme)
										th(style="width: 180px;") 제안자
										th 제안일시
								tbody#injeong-data

				//- 2. 상점 아이템 DB 관리
				div#tab-shop.tab-content
					div.content-card
						div.card-header
							h2: span 상점 아이템 DB 관리
							p 상점 상품 가격, 기간, 효과 속성(JSON)을 조회 및 추가하며 게임 내 상점을 업데이트합니다.
						div.card-actions.flex-wrap
							div.search-bar
								i.fa.fa-search
								input#shop-word(placeholder='품목 ID 또는 ~ALL 입력')
								button#shop-go.btn.btn-cyan 조회
							div.actions-divider
							button#shop-hide.btn.btn-outline-indigo: i.fa.fa-eye-slash  기존 상품 숨김 토글
							button#shop-add.btn.btn-solid-emerald: i.fa.fa-plus  새 상품 행 추가
							button#shop-apply.btn.btn-solid-blue: i.fa.fa-save  상점 DB 저장 적용
						div.table-wrapper
							table.admin-table
								thead
									tr
										th ID
										th 가격 (Cost)
										th 구매수 (Hit)
										th 기간 (Term)
										th 그룹 (Group)
										th 수정시간
										th 옵션 구조 (Options JSON)
										th 이름 (KO)
										th 설명 (KO)
										th 이름 (EN)
										th 설명 (EN)
								tbody#shop-data

				//- 3. 유저 데이터 DB 관리
				div#tab-users.tab-content
					div.content-card
						div.card-header
							h2: span 유저 데이터 DB 관리
							p 유저의 고유 재화 보유량, 등급 정보, 장착 외형, 제재(블랙리스트) 여부를 손쉽게 제어합니다.
						div.card-actions.flex-wrap
							div.search-bar-double
								div.search-input-wrapper
									i.fa.fa-id-card
									input#user-id(placeholder='유저 고유 ID')
								div.search-input-wrapper
									i.fa.fa-user
									input#user-nick(placeholder='유저 닉네임')
								button#user-go.btn.btn-cyan 검색 조회
							div.actions-divider
							button#user-apply.btn.btn-solid-blue: i.fa.fa-save  유저 설정 저장 적용
						div.table-wrapper
							table.admin-table
								thead
									tr
										th ID
										th 보유 머니
										th 끄투 스탯 (Stats JSON)
										th 상자 스탯 (Boxes JSON)
										th 장착 아이템 (Equip JSON)
										th 타이틀(칭호)
										th 서버
										th 마지막 로그인
										th 블랙리스트 여부
										th 친구 목록 (Friends JSON)
								tbody#user-data

				//- 4. 실시간 유저 감시
				div#tab-gamsi.tab-content
					div.content-card
						div.card-header
							h2: span 실시간 유저 감시
							p 의심스러운 행위를 하거나 모니터링이 필요한 유저의 활동 서버 및 닉네임을 실시간 추적합니다.
						div.card-actions
							div.search-bar.grow
								i.fa.fa-terminal
								input#gamsi-id(placeholder='감시할 유저 ID들을 입력해 주세요 (여러 명일 경우 콤마 \',\' 로 구분)')
								button#gamsi-go.btn.btn-solid-red: i.fa.fa-desktop  실시간 추적 시작
						div.table-wrapper
							table.admin-table
								thead
									tr
										th 유저 고유 ID
										th 현재 닉네임
										th 활동 중인 서버 채널
								tbody#gamsi-data

				//- 5. 끄투 단어 DB 수정
				div#tab-kkutu.tab-content
					div.content-card
						div.card-header
							h2: span 끄투 단어 DB 개별 수정
							p 단어의 활성 플래그, 적용 주제(Theme), 품사 형태 및 사전적 정의 정보(Mean)를 정밀 편집합니다.
						div.card-actions
							div.search-bar
								i.fa.fa-keyboard-o
								input#db-word(placeholder='조회 및 수정할 단어 입력')
								button#db-go.btn.btn-cyan 단어 조회
							div.actions-divider
							button#word-add.btn.btn-solid-emerald: i.fa.fa-plus-circle  구조 하위 행 추가
							button#db-apply.btn.btn-solid-blue: i.fa.fa-save  수정 구조 변경 적용
						
						div.word-detail-container
							div.word-detail-summary
								div.summary-item
									span.label-text 대상 단어
									span#wd-id.value-badge -
								div.summary-item
									span.label-text 단어 플래그
									input#wd-flag(placeholder='Flag 번호 입력')
							
							div.table-wrapper
								table.admin-table
									thead
										tr
											th(style="width: 80px; text-align: center;") 순번 (Key)
											th(style="width: 140px;") 품사 속성 (Type)
											th(style="width: 180px;") 적용 주제 (Theme)
											th 단어 설명 및 뜻 (Mean)
											th(style="width: 160px; text-align: center;") 행 조정 및 삭제
									tbody#wd-data
							
							div.word-detail-footer
								div#word-flag.status-badge
								div#word-hit.status-badge

				//- 6. 단어 대량 추가
				div#tab-add-words.tab-content
					div.content-card
						div.card-header
							h2: span 단어 대량 일괄 등록
							p 특정 주제(Theme)에 매핑되는 단어 풀(Pool)을 엔터나 콤마 단위로 복사 붙여넣기하여 한번에 데이터베이스에 주입합니다.
						div.form-container
							div.form-group
								label(for='db-theme')
									i.fa.fa-tags
									span  적용할 주제 (Theme) 명칭
								input#db-theme(placeholder='주제 입력 (단어 검색 용도로 쓸 때는 ~주제명 형태로 조회 가능)')
							div.form-group
								label(for='db-list')
									i.fa.fa-list-ol
									span  대량 단어 데이터 목록
								textarea#db-list(rows=15, placeholder='사과\n바나나\n멜론\n수박\n(엔터키 혹은 콤마로 단어를 한 줄씩 구분하여 적어주세요.)')
							div.form-footer
								button#db-ok.btn.btn-solid-emerald: i.fa.fa-upload  단어 DB 대량 업로드 실행

				//- 7. 인기 단어 통계
				div#tab-stats.tab-content
					div.content-card
						div.card-header
							h2: span 끄투 실시간 인기 단어 통계
							p 게임 내에서 유저들이 가장 많이 외친 한국어 종합/최근/3글자/어인정/영어 단어 통계를 내며 반영합니다.
						div.card-actions
							button#kpw-query.btn.btn-solid-amber: i.fa.fa-line-chart  인기 순위 데이터 수집
							div.actions-divider
							button#kpw-flush.btn.btn-solid-green: i.fa.fa-save  통계 캐시 갱신 및 파일 저장
						
						div.stats-dashboard
							//- 동적 생성 테이블 바인딩 컨테이너
							div#kpw-table.stats-grid-row
							
							div.raw-data-card
								div.card-header-sub
									h3: i.fa.fa-code  Raw HTML 백업 데이터
								textarea#kpw-html(rows=8, placeholder='통계 결과의 원시 HTML 덤프가 여기에 자동으로 채워집니다.', readonly=true)
